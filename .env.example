# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，严禁提交到仓库）

# JWT 签名密钥（必填，至少 32 字节随机字符串）
WF_AUTH_JWT_SECRET="replace-with-at-least-32-bytes-random-secret"

# 七牛对象存储凭据（仅当 storage.provider=qiniu 时必填，严禁写入 YAML 配置文件）
# WF_STORAGE_QINIU_ACCESS_KEY=""
# WF_STORAGE_QINIU_SECRET_KEY=""

# RabbitMQ 密码（可选，设置后优先覆盖 YAML 中的 rabbitmq.password；生产严禁写入 YAML）
# WF_RABBITMQ_PASSWORD=""

# 可选：指定 YAML 配置文件路径（默认 configs/config.local.yaml）
# WF_CONFIG_FILE="configs/config.local.yaml"
